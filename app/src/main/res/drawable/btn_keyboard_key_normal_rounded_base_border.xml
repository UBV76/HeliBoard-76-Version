<?xml version="1.0" encoding="utf-8"?>
<!-- Glass key: soft shadow, key face, top-down gloss and a thin light edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow, offset downward -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Key face, lifted 2dp above the shadow -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_background_normal_lxx_base_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Gloss: light fading from the top edge -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Thin light edge -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="0.75dp" android:color="#26FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
